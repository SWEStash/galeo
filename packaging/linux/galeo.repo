# galeo's dnf repository (ADR-036): save as /etc/yum.repos.d/galeo.repo, with the key at the path below
# (USAGE). The package keeps that key current, so rotations and revocations arrive with each upgrade.
[galeo]
name=galeo
baseurl=https://swestash.github.io/galeo/rpm/
enabled=1
gpgcheck=1
repo_gpgcheck=1
gpgkey=file:///etc/pki/rpm-gpg/RPM-GPG-KEY-galeo
