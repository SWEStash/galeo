#!/bin/sh
# galeo command-line launcher. Reads galeo's own flags anywhere before `--`, then passes them
# first, then `--`, then every file as an absolute path, so no file name can be read as an Electron
# or Chromium switch (SR-13).
set -eu

GALEO_BIN="${GALEO_BIN:-/opt/galeo/galeo}"

die() {
  printf 'galeo: %s\n' "$1" >&2
  printf 'usage: galeo [--profile NAME] [--new-window] [--no-sandbox] [file...] [-- file...]\n' >&2
  exit 2
}

cwd=$(pwd)
remaining=$#
reading_flags=1

# Rebuild "$@" in place: each original argument is shifted off the front and its translation
# appended at the back, tagged `o` (a flag) or `f` (a file, made absolute).
while [ "$remaining" -gt 0 ]; do
  arg=$1
  shift
  remaining=$((remaining - 1))
  if [ "$reading_flags" -eq 1 ]; then
    case $arg in
      --)
        reading_flags=0
        continue
        ;;
      --new-window | --no-sandbox | --galeo-sandbox-unavailable=*)
        set -- "$@" "o$arg"
        continue
        ;;
      --profile=)
        die '--profile needs a value'
        ;;
      --profile=*)
        set -- "$@" "o$arg"
        continue
        ;;
      --profile)
        [ "$remaining" -gt 0 ] || die '--profile needs a value'
        value=$1
        shift
        remaining=$((remaining - 1))
        case $value in -* | '') die '--profile needs a value' ;; esac
        set -- "$@" o--profile "o$value"
        continue
        ;;
      -*)
        die "unknown option: $arg"
        ;;
    esac
  fi
  case $arg in
    /*) set -- "$@" "f$arg" ;;
    *) set -- "$@" "f$cwd/$arg" ;;
  esac
done

# Two copies of the tagged list: the flags come from the first, the files from the second.
count=$#
set -- "$@" "$@"
index=0
while [ "$index" -lt $((count * 2)) ]; do
  arg=$1
  shift
  index=$((index + 1))
  [ "$index" -eq $((count + 1)) ] && set -- "$@" --
  if [ "$index" -le "$count" ]; then
    case $arg in o*) set -- "$@" "${arg#o}" ;; esac
  else
    case $arg in f*) set -- "$@" "${arg#f}" ;; esac
  fi
done

[ "$count" -gt 0 ] || set -- --
exec "$GALEO_BIN" "$@"
