{
  "name": "galeo",
  "version": "0.0.0-development",
  "private": true,
  "description": "A fast, private desktop reader for Markdown, text and log files",
  "license": "MIT",
  "author": "SWEStash",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "install-electron && husky",
    "typecheck": "tsc -b",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config build/vite.main.config.ts",
    "build:preload": "vite build --config build/vite.preload.config.ts",
    "build:renderer": "vite build --config build/vite.renderer.config.ts",
    "start": "electron .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:renderer": "vitest run --project renderer",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run boundaries && npm test",
    "test:e2e": "playwright test --project=e2e",
    "test:no-network": "playwright test --project=no-network"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "happy-dom": "20.14.5",
    "husky": "9.1.7",
    "semantic-release": "25.0.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "main": "out/main/index.js"
}
