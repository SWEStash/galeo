{
  "name": "galeo",
  "version": "0.0.0-development",
  "private": true,
  "description": "A fast, private desktop reader for Markdown, text and log files",
  "license": "MIT",
  "author": "SWEStash",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "install-electron",
    "typecheck": "tsc -b",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config build/vite.main.config.ts",
    "build:preload": "vite build --config build/vite.preload.config.ts",
    "build:renderer": "vite build --config build/vite.renderer.config.ts",
    "start": "electron ."
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "main": "out/main/index.js"
}
