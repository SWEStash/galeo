{
  "name": "galeo",
  "version": "0.2.0",
  "private": true,
  "description": "A fast, private desktop reader for Markdown, text and log files",
  "license": "MIT",
  "author": "SWEStash",
  "desktopName": "galeo.desktop",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "install-electron && husky",
    "typecheck": "tsc -b",
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "vite build --config build/vite.main.config.ts",
    "build:preload": "vite build --config build/vite.preload.config.ts",
    "build:renderer": "vite build --config build/vite.renderer.config.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --config electron-builder.config.mjs --publish never",
    "verify:package": "node scripts/verify-package.mjs",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:renderer": "vitest run --project renderer",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check:bundle": "node scripts/bundle-report.mjs",
    "check": "npm run typecheck && npm run boundaries && npm test",
    "test:e2e": "playwright test --project=e2e",
    "test:no-network": "playwright test --project=no-network",
    "test:perf": "playwright test --project=perf",
    "headless": "sh scripts/headless.sh",
    "preflight": "sh scripts/preflight.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@electron/fuses": "2.1.3",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "happy-dom": "21.0.1",
    "husky": "9.1.7",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "overrides": {
    "rehype-katex": {
      "katex": "$katex"
    },
    "mermaid": {
      "katex": "$katex"
    },
    "micromark-extension-math": {
      "katex": "$katex"
    }
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/merge": "6.12.2",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.14",
    "@lezer/highlight": "1.2.5",
    "@shikijs/rehype": "4.5.0",
    "dompurify": "3.4.16",
    "katex": "0.19.0",
    "mermaid": "12.1.0",
    "react": "19.3.0",
    "react-aria-components": "1.22.1",
    "react-dom": "19.3.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "zod": "4.6.5"
  },
  "main": "out/main/index.js"
}
